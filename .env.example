# Copy these values into your server environment. Never commit the real values.
# GitHub Pages must not contain any Spring or Supabase secret.

# Backend deployment
PORT=4173
FRONTEND_ORIGIN=https://barsaa572-blip.github.io

# Database / authentication (to be created in Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# FX policy: agency top-ups use the exact Golomt Bank CNY non-cash SELL rate.
# A CNY refund from Spring is converted to MNT using Golomt Bank CNY non-cash BUY only.
# Wallet balances remain CNY; the applicable rate is snapshotted on invoices/bookings.
GOLOMT_BANK_CNY_RATE_API_URL=http://127.0.0.1:8000/api/rates/bank/GolomtBank?limit=1
TOPUP_CNY_MARKUP_MNT=0
# Manual fallback only, used if the automatic source is temporarily unavailable.
GOLOMT_BANK_CNY_NONCASH_BUY=
GOLOMT_BANK_CNY_NONCASH_SELL=
GOLOMT_BANK_CNY_RATE_DATE=

# Spring HTTP JSON APIs (use full URL per interface; do not assume one shared path)
SPRING_HTTP_BASE_URL=http://101.230.218.71:8001/gdsgatewayota
SPRING_TOKEN_URL=http://101.230.218.71:8001/gdsgatewayota/auth/oauth2/accessToken
SPRING_REFRESH_TOKEN_URL=http://101.230.218.71:8001/gdsgatewayota/auth/oauth2/refreshToken
SPRING_FLIGHT_SEARCH_URL=http://101.230.218.71:8001/gdsgatewayota/weekApiFlightSearch/ota/flights/searchFlightsOtaDayKegui
SPRING_PRICE_CHECK_URL=http://101.230.218.71:8001/gdsgatewayota/apiFlightSearch/ota/normalFlightSearch/getSpecificPriceNew
SPRING_FARE_RULES_URL=http://101.230.218.71:8001/gdsgatewayota/apiFlightSearch/ota/flights/searchKeguiBySegId
SPRING_BOOK_ORDER_URL=http://101.230.218.71:8001/gdsgatewayota/apiOrder/ota/orderOtaCtr/bookOrderC
SPRING_CANCELLATION_FEE_URL=http://101.230.218.71:8001/gdsgatewayota/apiOrder/ota/orderOtaCtr/calcRetTktFeeOTA
SPRING_REFUND_URL=http://101.230.218.71:8001/gdsgatewayota/apiOrder/ota/orderOtaCtr/refundTicketB2cAgentOTA
SPRING_CHANGE_INFO_URL=http://101.230.218.71:8001/gdsgatewayota/apiOrder/ota/orderOtaCtr/getFlightBgInfo
SPRING_CHANGE_AVAILABILITY_URL=http://101.230.218.71:8001/gdsgatewayota/apiOrder/ota/orderOtaCtr/getFlightBgApp
SPRING_SUBMIT_CHANGE_URL=http://101.230.218.71:8001/gdsgatewayota/apiOrder/ota/orderOtaCtr/submitFlightBgOTA
SPRING_OAUTH_CLIENT_ID=
SPRING_OAUTH_CLIENT_SECRET=
SPRING_AGENT_CODE=
# Test only: bookOrderC is blocked unless explicitly enabled on the server.
SPRING_BOOKING_ENABLED=false
# Public fixed IP whitelisted by Spring, if their payload validation requires it.
# Mandatory for bookOrderC. Use the static public IP whitelisted by Spring.
SPRING_REMOTE_IP=YOUR_VPS_STATIC_IP

# Spring XML/SOAP integrations. Keep all real values only in the VPS env file.
SPRING_XML_WSDL_URL=
SPRING_XML_USERNAME=
SPRING_XML_PASSWORD=
SPRING_XML_ORDER_DETAILS_ACTION=

# Spring credit payment and automatic ticket issue (payInCredit4OTA XML/SOAP).
# Enable only after Spring confirms the test integration is ready.
SPRING_CREDIT_PAYMENT_WSDL_URL=
# getOrderDetailInfoC2 XML/SOAP lookup used to resolve orderHeadId before refund.
# Leave blank to reuse SPRING_CREDIT_PAYMENT_WSDL_URL.
SPRING_ORDER_DETAIL_WSDL_URL=
SPRING_CREDIT_PAYMENT_ENABLED=false
SPRING_CREDIT_MONEY_CLASS_ID=0
SPRING_CREDIT_ORDER_TYPE=0
