# Copy these values into your server environment. Never commit the real values.
# GitHub Pages must not contain any Spring or Supabase secret.

# Backend deployment
PORT=4173
FRONTEND_ORIGIN=https://barsaa572-blip.github.io

# Database / authentication (to be created in Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Pricing: the server automatically reads CNY from the documented JSON endpoint below.
# Agent-facing quotes/invoices are calculated as CNY × (official rate + 4 MNT).
# Values are snapshotted on each invoice/booking; wallet balances remain CNY.
MONGOLBANK_CNY_RATE_API_URL=http://127.0.0.1:8000/api/rates/bank/MongolBank?limit=1
# Manual fallback only, used if the automatic source is temporarily unavailable.
MONGOLBANK_CNY_RATE=
MONGOLBANK_CNY_RATE_DATE=

# Spring HTTP JSON APIs
SPRING_HTTP_BASE_URL=
SPRING_OAUTH_CLIENT_ID=
SPRING_OAUTH_CLIENT_SECRET=
SPRING_AGENT_CODE=

# Spring XML order query API
SPRING_XML_WSDL_URL=http://101.230.218.72:2001/AirSalesService/springairlines/remoteservice/airsalesLLC?wsdl
SPRING_XML_USERNAME=
SPRING_XML_PASSWORD=
# To be filled after Spring provides the SOAP XML request example.
SPRING_XML_ORDER_DETAILS_ACTION=
