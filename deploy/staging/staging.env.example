# Template only. Real values belong in /etc/flightb2b-test/flightb2b-test.env.
APP_ENV=staging
PORT=4174
FRONTEND_ORIGIN=https://test.nexahub.airsales.ub.mn
TRUST_PROXY_LOOPBACK=true

# SEPARATE test Supabase project; never paste production keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated exact test origins, e.g. https://test-api.example:8443
# Obtain the actual endpoints from Spring. No production defaults are provided.
STAGING_SPRING_ALLOWED_ORIGINS=
SPRING_HTTP_BASE_URL=
SPRING_TOKEN_URL=
SPRING_REFRESH_TOKEN_URL=
SPRING_FLIGHT_SEARCH_URL=
SPRING_PRICE_CHECK_URL=
SPRING_FARE_RULES_URL=
SPRING_BOOK_ORDER_URL=
SPRING_CANCELLATION_FEE_URL=
SPRING_REFUND_URL=
SPRING_CHANGE_INFO_URL=
SPRING_CHANGE_AVAILABILITY_URL=
SPRING_SUBMIT_CHANGE_URL=
SPRING_ORDER_RETRIEVE_URL=
SPRING_OAUTH_CLIENT_ID=
SPRING_OAUTH_CLIENT_SECRET=
SPRING_AGENT_CODE=
SPRING_REMOTE_IP=202.131.1.50

SPRING_XML_WSDL_URL=
SPRING_XML_USERNAME=
SPRING_XML_PASSWORD=
SPRING_XML_ORDER_DETAILS_ACTION=
SPRING_CREDIT_PAYMENT_WSDL_URL=
SPRING_ORDER_DETAIL_WSDL_URL=
SPRING_CREDIT_MONEY_CLASS_ID=0
SPRING_CREDIT_ORDER_TYPE=0
SPRING_CREDIT_CHANGE_ORDER_TYPE=2

# Leave disabled for initial setup. Enable only after test-provider checks.
SPRING_BOOKING_ENABLED=false
SPRING_CREDIT_PAYMENT_ENABLED=false
STAGING_TRANSACTIONS_CONFIRMED=false

# Read-only FX source, same local rate service; no wallet data is shared.
GOLOMT_BANK_CNY_RATE_API_URL=http://127.0.0.1:8000/api/rates/bank/GolomtBank?limit=1
TOPUP_CNY_MARKUP_MNT=0
